---
import { principles } from '../data/site';
---

<section>
  <h2>How I work</h2>
  <div class="principles">
    {
      principles.map((p) => (
        <div class="principle">
          <div class="name">{p.name}</div>
          <div class="desc">{p.desc}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .principles {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .principle {
    display: grid;
    grid-template-columns: 180px 1fr;
    gap: 24px;
    padding: 20px 0;
    border-top: 1px solid var(--line);
  }
  .principle:first-child {
    border-top: none;
  }
  .name {
    font-weight: 600;
    font-size: 16px;
  }
  .desc {
    color: var(--text-dim);
    font-size: 15px;
    max-width: 52ch;
  }

  @media (max-width: 600px) {
    .principle {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
</style>
