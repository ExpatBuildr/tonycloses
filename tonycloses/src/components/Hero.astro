---
import SocialIcons from './SocialIcons.astro';
import { hero, site } from '../data/site';
---

<header class="hero">
  <div class="identity-row">
    <p class="kicker">{hero.kicker}</p>
    <SocialIcons />
  </div>
  <h1>{hero.headline}</h1>
  <p class="lede">{hero.lede}</p>
  <div class="cta-row">
    <a class="btn" href={site.bookingUrl}>{hero.primaryCta}</a>
    <a class="btn-ghost" href="#track-record">{hero.secondaryCta}</a>
  </div>
</header>

<style>
  header.hero {
    padding: 48px 0 64px;
    border-bottom: 1px solid var(--line);
  }
  .identity-row {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 24px;
  }
  .kicker {
    color: var(--text-dim);
    font-size: 15px;
    margin: 0 0 6px;
  }
  h1 {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    max-width: 14ch;
  }
  .lede {
    font-size: 19px;
    color: var(--text-dim);
    max-width: var(--serif-measure);
    margin: 0 0 36px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }
</style>
