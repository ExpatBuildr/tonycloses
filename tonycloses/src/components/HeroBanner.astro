---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.jpg';
import { hero } from '../data/site';
---

<div class="hero-banner">
  <Image
    src={heroImage}
    alt={hero.bannerAlt}
    widths={[480, 768, 1200, 1536]}
    sizes="100vw"
    format="webp"
    quality={80}
    loading="eager"
    fetchpriority="high"
  />
</div>

<style>
  .hero-banner {
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 600px;
    overflow: hidden;
  }
  .hero-banner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    display: block;
  }

  @media (max-width: 600px) {
    .hero-banner {
      aspect-ratio: 4 / 5;
      max-height: 420px;
    }
  }
</style>
