---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import StickyCta from '../components/StickyCta.astro';
import HeroBanner from '../components/HeroBanner.astro';
import Hero from '../components/Hero.astro';
import TrackRecord from '../components/TrackRecord.astro';
import LoomVideo from '../components/LoomVideo.astro';
import HowIWork from '../components/HowIWork.astro';
import Background from '../components/Background.astro';
import About from '../components/About.astro';
import BookCta from '../components/BookCta.astro';
import Terms from '../components/Terms.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
---

<Layout
  title={site.title}
  description={site.description}
  shareTitle={site.shareTitle}
  shareDescription={site.shareDescription}
  shareImageAlt={site.shareImageAlt}
>
  <Nav />
  <HeroBanner />
  <div class="wrap">
    <Hero />
    <TrackRecord />
    <LoomVideo />
    <HowIWork />
    <Background />
    <About />
    <BookCta />
    <Terms />
    <Faq />
    <Footer />
  </div>
  <StickyCta />
</Layout>
