---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import SocialIcons from './SocialIcons.astro';
import { about, hero, site } from '../data/site';
---

<header class="hero">
  <div class="identity-row">
    <div class="avatar">
      <Image
        src={headshot}
        alt={about.photoAlt}
        width={128}
        height={128}
        format="webp"
        quality={85}
        loading="eager"
      />
    </div>
    <div class="identity-text">
      <p class="kicker">{hero.kicker}</p>
      <SocialIcons />
    </div>
  </div>
  <h1>{hero.headline}</h1>
  <p class="lede">{hero.lede}</p>
  <div class="cta-row">
    <a class="btn" href={site.bookingUrl}>{hero.primaryCta}</a>
    <a class="btn-ghost" href="#track-record">{hero.secondaryCta}</a>
  </div>
</header>

<style>
  header.hero {
    padding: 48px 0 64px;
    border-bottom: 1px solid var(--line);
  }
  .identity-row {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 28px;
  }
  .avatar {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px rgba(47, 191, 113, 0.15);
  }
  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .identity-text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .kicker {
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    margin: 0;
  }
  h1 {
    font-size: clamp(34px, 5vw, 52px);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.01em;
    margin: 0 0 24px;
    max-width: 14ch;
  }
  .lede {
    font-size: 19px;
    color: var(--text-dim);
    max-width: var(--serif-measure);
    margin: 0 0 36px;
  }
  .cta-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    align-items: center;
  }
</style>
