---
import { bookCta, site } from '../data/site';
---

<section class="close-cta" id="book">
  <h2>{bookCta.heading}</h2>
  <p>{bookCta.body}</p>
  <a class="btn" href={site.bookingUrl}>{bookCta.button}</a>
  <p class="response-time">{bookCta.responseTime}</p>
</section>

<style>
  .close-cta {
    text-align: left;
  }
  .close-cta h2 {
    font-size: 26px;
    color: var(--text);
    font-weight: 600;
    margin-bottom: 14px;
  }
  .close-cta p {
    color: var(--text-dim);
    font-size: 16px;
    max-width: var(--serif-measure);
    margin-bottom: 28px;
  }
  /* More specific than `.close-cta p` so the small caption size actually applies. */
  .close-cta p.response-time {
    font-size: 13px;
    margin-top: 14px;
    margin-bottom: 0;
  }
</style>
