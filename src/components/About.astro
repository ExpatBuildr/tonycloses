---
import { Image } from 'astro:assets';
import headshot from '../assets/headshot.jpg';
import { about } from '../data/site';
---

<section id="about">
  <h2>About</h2>
  <div class="bio-row">
    <div class="bio-photo">
      <Image
        src={headshot}
        alt={about.photoAlt}
        width={176}
        height={176}
        format="webp"
        quality={85}
        loading="lazy"
      />
    </div>
    <p class="bio-text">{about.bio}</p>
  </div>
</section>

<style>
  .bio-row {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .bio-photo {
    width: 88px;
    height: 88px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-raised);
    border: 1px solid var(--line);
    flex-shrink: 0;
  }
  .bio-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .bio-text {
    color: var(--text-dim);
    font-size: 15px;
    max-width: 52ch;
    margin: 0;
  }

  @media (max-width: 600px) {
    .bio-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
  }
</style>
